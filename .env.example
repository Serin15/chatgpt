# Export these variables before starting the server; .env is not loaded automatically.
# Never store wallet private keys or seed phrases in this application.
DATA_DIR=data
SCAN_INTERVAL_SECONDS=90
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PAPER_START_USD=100
MIN_LIQUIDITY_USD=25000
MAX_ALLOCATION=0.20
MAX_EXPOSURE=0.50
DAILY_LOSS_LIMIT=0.10
MAX_PRICE_IMPACT=0.02
SIM_SWAP_FEE=0.003
SIM_NETWORK_FEE_USD=0.01
MIN_POSITION_USD=2
SIM_CEX_FEE=0.006
SIM_REFERENCE_SLIPPAGE=0.005
# Level 3 worker starts automatically. These defaults apply only when creating
# a new data directory; later settings are persisted via the dashboard/API.
OPPORTUNITY_ENGINE_ENABLED=1
OPPORTUNITY_INTERVAL_SECONDS=60
OPPORTUNITY_SECURITY_BUDGET=8
# Optional bounded RPC samples (0 disables; public RPC can rate-limit):
OPPORTUNITY_ACTIVITY_SAMPLES=0
# Optional AI narrative classification uses the configured engine/daily budget:
OPPORTUNITY_AI_NARRATIVES=0
# Sending requires explicit enablement AND bot token + chat ID below:
OPPORTUNITY_TELEGRAM_ENABLED=0
# Declare an ISO 8601 future cutoff before collecting a holdout:
# OPPORTUNITY_TEST_FROM=2026-12-01T00:00:00Z
# Optional, only if the provider requires authentication:
# GOPLUS_ACCESS_TOKEN=
# Optional AI; disabled until configured in the application or via these variables.
# PULSE_AI_PROVIDER=ollama
# PULSE_AI_MODEL=your-exact-installed-model
# OpenAI API is an alternative with separate API credit. Never put a key in Git or chat.
# PULSE_AI_PROVIDER=openai
# PULSE_AI_MODEL=your-available-structured-output-model
# PULSE_AI_API_KEY=
# Existing OPENAI_API_KEY is accepted as a fallback on local installations.

# Advanced read-only integrations (optional):
# BASE_RPC_URL=https://mainnet.base.org
# PAPER_SOLANA_EXECUTION=jupiter
# JUPITER_API_KEY_FILE=/path/outside/repository/jupiter-key
# TELEGRAM_BOT_TOKEN_FILE=/path/outside/repository/telegram-token
# TELEGRAM_CHAT_ID=destination-you-control
# PULSE_AI_API_KEY_FILE=/path/outside/repository/openai-key
# PULSE_OLLAMA_URL=http://127.0.0.1:11434
# Hosted single-owner authentication; requires HTTPS reverse proxy and a strong password:
# PULSE_HOSTED=1
# PULSE_PUBLIC_ORIGIN=https://your-domain.example
# PULSE_AUTH_PASSWORD_FILE=/path/outside/repository/pulse-password
# For compose.yaml only (Compose reads .env for interpolation; native app does not):
# PULSE_DOMAIN=your-domain.example
# PULSE_PASSWORD_FILE=/path/outside/repository/pulse-password
# PULSE_AI_KEY_FILE=/path/outside/repository/openai-key
