# Export these variables before starting the server; .env is not loaded automatically.
# Never store wallet private keys or seed phrases in this application.
DATA_DIR=data
SCAN_INTERVAL_SECONDS=90
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PAPER_START_USD=100
MIN_LIQUIDITY_USD=25000
MAX_ALLOCATION=0.20
MAX_EXPOSURE=0.50
DAILY_LOSS_LIMIT=0.10
MAX_PRICE_IMPACT=0.02
SIM_SWAP_FEE=0.003
SIM_NETWORK_FEE_USD=0.01
MIN_POSITION_USD=2
SIM_CEX_FEE=0.006
SIM_REFERENCE_SLIPPAGE=0.005
# Optional, only if the provider requires authentication:
# GOPLUS_ACCESS_TOKEN=
# Optional AI; disabled until configured in the application or via these variables.
# PULSE_AI_PROVIDER=ollama
# PULSE_AI_MODEL=your-exact-installed-model
# OpenAI API is an alternative with separate API credit. Never put a key in Git or chat.
# PULSE_AI_PROVIDER=openai
# PULSE_AI_MODEL=your-available-structured-output-model
# PULSE_AI_API_KEY=
# Existing OPENAI_API_KEY is accepted as a fallback on local installations.
